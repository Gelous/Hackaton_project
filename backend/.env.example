AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Background scheduler cadence, in minutes. Default 240 (4 hours).
# Set to 1-2 for a fast demo loop.
MONITOR_INTERVAL_MINUTES=240

# Optional: verified SES sender identity to enable email alerts.
# Without this, updates still land in the in-app notification inbox.
SES_SENDER_EMAIL=
