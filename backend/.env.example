AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Background scheduler cadence, in minutes. Default 240 (4 hours).
# Set to 1-2 for a fast demo loop.
MONITOR_INTERVAL_MINUTES=240

# Optional: verified SES sender identity to enable email alerts.
# Without this, updates still land in the in-app notification inbox.
SES_SENDER_EMAIL=

# Optional: enables real local event/concert listings in "Plan My Day".
# Free signup at https://developer.ticketmaster.com/ -> get a Consumer Key.
# Without this, the day planner still works but only links out to a real
# Ticketmaster search instead of showing specific event names.
TICKETMASTER_API_KEY=
